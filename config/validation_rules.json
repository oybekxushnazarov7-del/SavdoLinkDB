{
  "rules": {
    "SKU_REQUIRED":     { "enabled": true, "severity": "ERROR" },
    "DATE_REQUIRED":    { "enabled": true, "severity": "ERROR" },
    "QTY_IS_INT":       { "enabled": true, "severity": "ERROR" },
    "QTY_POSITIVE":     { "enabled": true, "severity": "ERROR" },
    "PRICE_IS_NUMERIC": { "enabled": true, "severity": "ERROR" },
    "DISCOUNT_RANGE":   { "enabled": true, "severity": "ERROR", "min": 0, "max": 100 },
    "PRICE_DEVIATION":  { "enabled": true, "severity": "WARNING", "max_factor": 1.5 },
    "CASHIER_STORE":    { "enabled": true, "severity": "WARNING" }
  },
  "thresholds": {
    "max_reject_pct": 15.0,
    "min_completeness_pct": 95.0,
    "min_uniqueness_pct": 98.0,
    "min_validity_pct": 85.0,
    "min_consistency_pct": 90.0
  }
}
